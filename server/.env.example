# Claude API key — powers the L3 analyst deep-dive and fundamental scoring.
# https://platform.claude.com  (the app runs without it; verdicts fall back to
# the deterministic engine when unset).
ANTHROPIC_API_KEY=

# Optional model overrides
# ANTHROPIC_DEEPDIVE_MODEL=claude-opus-4-8
# ANTHROPIC_ANALYST_MODEL=claude-sonnet-4-6

# Market data. Preferred source is Yahoo via the Python sidecar (free, full
# history, no rate cap) — it needs yfinance in the python Node calls:
#   pip install -r server/scripts/requirements.txt
# Point this at that python (default python3; use a venv path if yfinance lives
# there, e.g. the stock-analyzer venv). Set YF_DISABLE=1 to skip Yahoo entirely.
# YF_PYTHON=python3
# YF_DISABLE=1

# Fallback source when the sidecar is unavailable (free key, 800 req/day, 8/min).
# https://twelvedata.com/pricing (Basic/Free)
# TWELVE_DATA_API_KEY=

# Offline/demo data (never uses live Yahoo/Stooq). 1 = always fixtures.
# STOCK_FIXTURES=1
# Or fall back to demo data only when every live source is blocked:
# STOCK_FIXTURES_FALLBACK=1

# Scanner universe size — how many of the ~100 largest US names get ranked
# (default 50, sized for the Twelve Data free tier's 8-req/min pacing when the
# Yahoo sidecar is down; series are cached 24h). Raise it if the sidecar is healthy.
# SCANNER_UNIVERSE_SIZE=50
# Scan the full S&P 500 from Wikipedia instead of the curated large-cap list
# (needs quota + patience — ~500 symbols paced at 8/min).
# SCANNER_FULL_UNIVERSE=1
# Scanner: opt in to the short-interest factor. One Python subprocess per ticker
# (shortRatio comes off the sidecar's fundamentals payload) — slow, and plenty of
# names have no value, so they drop out of the factor.
# SCANNER_SHORT_INTEREST=1

# Market clock for the nightly scanner (21:15) and weekly analyst (Sun 03:00)
# jobs. Pinned so they don't drift with DST or run mid-afternoon ET on a UTC box.
# MARKET_TZ=America/New_York

# Buy-zone alert emails via Resend (optional — alerts still show as "triggered"
# in the UI without these). https://resend.com
# RESEND_API_KEY=
# ALERT_EMAIL=you@example.com
# ALERT_FROM=Market Specialist <onboarding@resend.dev>
# NOTE: with the shared onboarding@resend.dev sender, Resend only delivers to your
# own Resend account address. Verify a domain to send anywhere else.

# SQLite location (defaults to server/stock-checker.db)
# DB_PATH=./stock-checker.db

PORT=3001
